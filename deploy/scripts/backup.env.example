# Copy to backup.env (gitignored) on the Windows server PC.
# Script runs ON THE HOST (not inside Docker) — use 127.0.0.1, not host.docker.internal.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diemdanhngay_bv87_db
DB_USER=diemdanh_user
DB_PASS=your-production-password

# Optional: full path to mysqldump.exe if it is not on PATH
# MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# Keep this many daily folders under backup\backup_ddMMyyyy
RETENTION_DAYS=7
