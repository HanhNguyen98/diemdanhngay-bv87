# Copy to deploy/.env on server (gitignored pattern: add deploy/.env locally)

# MySQL on host (shared with survey app)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=diemdanhngay_bv87_db
DB_USER=diemdanh_user
DB_PASS=your-production-password

# LAN port (survey uses 8080)
ATTENDANCE_PORT=8081

# CORS — thêm domain Cloudflare khi có (phân tách bằng dấu phẩy)
APP_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=http://192.170.182.14:8081,https://diemdanh.example.com

# false = cho phép session cookie qua HTTP LAN :8081
# true = bắt buộc HTTPS (dùng khi chỉ truy cập qua Cloudflare)
SESSION_COOKIE_SECURE=false

# Cloudflare Tunnel — chỉ cần khi chạy profile tunnel
# CF_TUNNEL_TOKEN=your-tunnel-token-from-cloudflare-dashboard
