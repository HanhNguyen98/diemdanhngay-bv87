<Window x:Class="BV87.App.Windows.AgentScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        xmlns:strings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="{x:Static strings:AgentUiStrings.WindowTitle}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfacePageBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: logo BV + metadata (SPEC §2.22 — cấm footer status) -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20,16" Margin="0,0,0,16">
            <StackPanel>
                <controls:HospitalLogo LogoSize="100"
                                       Layout="Vertical"
                                       ShowHospitalName="True"
                                       ShowAppSubtitle="True"
                                       SubtitleFontSize="20"
                                       HospitalNameFontSize="18"
                                       HospitalNameFontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,14"/>

                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="{x:Static strings:AgentUiStrings.DeptLabelPrefix}"
                                   Foreground="{StaticResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DeptDisplay}" Foreground="{StaticResource NavyBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="{x:Static strings:AgentUiStrings.KioskLabelPrefix}"
                                   Foreground="{StaticResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding KioskLabel}" Foreground="{StaticResource NavyBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="{x:Static strings:AgentUiStrings.TemplateCountLabel}"
                                   Foreground="{StaticResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TemplateCountText}" Foreground="{StaticResource NavyBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerFgBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessFgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{x:Static strings:AgentUiStrings.DeviceStatusLabel}"
                                   Foreground="{StaticResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DeviceStatusText}" Foreground="{StaticResource NavyBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="16,14" CornerRadius="10" Margin="0,0,0,20"
                Background="{Binding BannerTone, Converter={StaticResource BannerToneBrush}, ConverterParameter=Bg}">
            <TextBlock Text="{Binding BannerMessage}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{Binding BannerTone, Converter={StaticResource BannerToneBrush}, ConverterParameter=Fg}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="32" MaxWidth="560" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid MinHeight="360">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasPreviewImage, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE962;"
                               FontSize="96" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="{x:Static strings:AgentUiStrings.WaitingForFinger}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ContentMutedBrush}"
                               FontSize="{StaticResource FontSizeXl}"/>
                </StackPanel>
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
