<Window x:Class="BV87.App.Windows.ModeSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BV87 — Chọn chế độ"
        Height="360" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="24" Padding="24" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Chọn chế độ làm việc" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="UserSummaryText" Foreground="{StaticResource ContentMutedBrush}" Margin="0,0,0,20"/>

            <Button x:Name="AdminButton" Content="Quản trị viên" Height="40" Margin="0,0,0,8"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="AdminButton_Click"/>
            <Button x:Name="HeadButton" Content="Trưởng đơn vị" Height="40" Margin="0,0,0,8"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="HeadButton_Click"/>
            <Button x:Name="KioskButton" Content="Kiosk vân tay" Height="40"
                    Background="#F3F4F6" Foreground="{StaticResource NavyBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand"
                    Click="KioskButton_Click"/>
        </StackPanel>
    </Border>
</Window>
