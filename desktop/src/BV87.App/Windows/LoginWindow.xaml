<Window x:Class="BV87.App.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        xmlns:shell="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="{x:Static shell:ShellUiStrings.WindowTitle}"
        Height="600" Width="480"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Image x:Name="LoginBackgroundImage"
               Stretch="UniformToFill"
               Visibility="Collapsed"/>
        <Border x:Name="LoginBackgroundOverlay"
                Background="#40000000"
                Visibility="Collapsed"/>

        <ScrollViewer VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Center">
            <Border Style="{StaticResource CardBorderFlatStyle}"
                    Margin="20,24"
                    Padding="28,32,28,36"
                    HorizontalAlignment="Center"
                    Width="400">
                <StackPanel>
                    <controls:HospitalLogo x:Name="HeaderLogo"
                                           Layout="Vertical"
                                           LogoSize="72"
                                           SubtitleFontSize="{StaticResource FontSizeStatLabel}"
                                           HospitalNameFontSize="{StaticResource FontSizeSm}"
                                           TextMargin="0,12,0,4"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,20"/>

                    <TextBlock Text="Tên đăng nhập" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource FilterTextBoxStyle}"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="Mật khẩu" Style="{StaticResource FormLabelStyle}"/>
                    <controls:PasswordField x:Name="PasswordField" Margin="0,0,0,12"/>

                    <Border x:Name="ErrorPanel"
                            Background="{StaticResource DangerBgBrush}"
                            BorderBrush="{StaticResource DangerFgBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="{StaticResource DangerFgBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeMd}"/>
                    </Border>

                    <Button x:Name="LoginButton"
                            Content="Đăng nhập"
                            Height="44"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="{StaticResource FontSizeBase}"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
