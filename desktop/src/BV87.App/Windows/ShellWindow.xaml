<Window x:Class="BV87.App.Windows.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BV87"
        Height="640" Width="1024"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfacePageBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource NavyBrush}" Padding="16,12">
            <DockPanel>
                <TextBlock x:Name="HeaderTitle" Text="BV87" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserInfoText" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Đăng xuất" Padding="12,6" Background="Transparent" Foreground="White" BorderBrush="#64748B" Cursor="Hand"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Margin="24" Padding="32" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ModeTitleText" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="ModeDescriptionText" TextWrapping="Wrap" Width="520" TextAlignment="Center"
                           Foreground="{StaticResource ContentMutedBrush}" Margin="0,0,0,16"/>
                <TextBlock x:Name="PhaseHintText" Text="Phase D0 — shell placeholder. Nghiệp vụ đầy đủ theo SPEC_DESKTOP."
                           TextWrapping="Wrap" Width="520" TextAlignment="Center" Foreground="{StaticResource ContentMutedBrush}"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
