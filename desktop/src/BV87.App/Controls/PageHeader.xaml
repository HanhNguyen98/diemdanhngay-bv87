<UserControl x:Class="BV87.App.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0"
                       Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding ActionsContent, ElementName=Root}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
