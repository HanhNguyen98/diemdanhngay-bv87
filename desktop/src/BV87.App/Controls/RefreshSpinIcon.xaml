<UserControl x:Class="BV87.App.Controls.RefreshSpinIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
    </UserControl.Resources>
    <TextBlock x:Name="Glyph"
               FontFamily="{StaticResource IconFont}"
               Text="&#xE72C;"
               FontSize="{Binding FontSize, ElementName=Root}"
               Foreground="{Binding Foreground, ElementName=Root}"
               VerticalAlignment="Center"
               RenderTransformOrigin="0.5,0.5">
        <TextBlock.RenderTransform>
            <RotateTransform x:Name="Rotate" Angle="0"/>
        </TextBlock.RenderTransform>
    </TextBlock>
</UserControl>
