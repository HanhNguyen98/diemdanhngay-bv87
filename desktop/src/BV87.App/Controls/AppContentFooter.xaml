<UserControl x:Class="BV87.App.Controls.AppContentFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:BV87.Core.Constants;assembly=BV87.Core">
    <Border Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,10">
        <TextBlock Text="{x:Static shell:ShellUiStrings.FooterCopyright}"
                   Foreground="{StaticResource ContentMutedBrush}"
                   FontSize="{StaticResource FontSizeSm}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Stretch"/>
    </Border>
</UserControl>
