<UserControl x:Class="BV87.App.Controls.DialogContextHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
        <TextBlock Text="{Binding PrimaryText, ElementName=Root}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource NavyBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SecondaryText, ElementName=Root}"
                   FontSize="13"
                   Foreground="{StaticResource ContentMutedBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="{Binding SecondaryText, ElementName=Root, Converter={StaticResource NullToVisibility}}"/>
    </StackPanel>
</UserControl>
