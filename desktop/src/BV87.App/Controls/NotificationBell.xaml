<UserControl x:Class="BV87.App.Controls.NotificationBell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
             x:Name="Root">
    <Grid>
        <Button x:Name="BellButton"
                Style="{StaticResource GhostButtonStyle}"
                Padding="8,8"
                MinWidth="44"
                MinHeight="44"
                ToolTip="{x:Static strings:NotificationUiStrings.BellAria}"
                Command="{Binding ToggleCommand}">
            <Grid Width="24" Height="24">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA8F;" FontSize="24"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource ContentHeadingBrush}"/>
                <Border MinWidth="20" Height="20" Padding="4,0"
                        CornerRadius="10"
                        Background="{StaticResource DangerFgBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-6,-6,0"
                        Visibility="{Binding ShowUnreadBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UnreadBadgeText}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Button>

        <Popup Placement="Bottom"
               PlacementTarget="{Binding ElementName=BellButton}"
               HorizontalOffset="-360"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsOpen, Mode=TwoWay}">
            <Border Width="400"
                    MaxHeight="480"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <TextBlock Text="{Binding PanelTitle}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ContentMutedBrush}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding LoadingMessage}"
                                       Foreground="{StaticResource ContentMutedBrush}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Margin="14,18"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding EmptyMessage}"
                                       Foreground="{StaticResource ContentMutedBrush}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Margin="14,18"
                                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ItemClickCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource LineBrush}"
                                                Padding="14,12"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{StaticResource FontSizeStatLabel}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ContentHeadingBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Body}"
                                                           FontSize="{StaticResource FontSizeMd}"
                                                           Foreground="{StaticResource ContentMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="56"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding CreatedAtText}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           Foreground="{StaticResource ContentMutedBrush}"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding CreatedAtText, Converter={StaticResource NullToVisibility}}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
