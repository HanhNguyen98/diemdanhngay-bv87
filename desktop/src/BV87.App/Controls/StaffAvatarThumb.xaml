<UserControl x:Class="BV87.App.Controls.StaffAvatarThumb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="36" Height="36">
    <Grid>
        <Grid>
            <Grid.Clip>
                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
            </Grid.Clip>
            <Border Background="{StaticResource NeutralBgBrush}">
                <Grid>
                    <TextBlock x:Name="InitialsText"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image x:Name="PreviewImage"
                           Stretch="UniformToFill"
                           Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
        <Ellipse Stroke="{StaticResource LineBrush}"
                 StrokeThickness="1"
                 IsHitTestVisible="False"/>
    </Grid>
</UserControl>
