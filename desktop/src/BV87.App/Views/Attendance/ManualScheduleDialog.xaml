<shell:AppDialogWindow x:Class="BV87.App.Views.Attendance.ManualScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:strings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="{x:Static strings:AttendanceUiStrings.ManualScheduleTitle}"
        Width="960"
        Height="640"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfacePageBrush}">
    <Grid>
        <Border Margin="24" Padding="24" Style="{StaticResource CardBorderFlatStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding StaffInfo}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static strings:AttendanceUiStrings.ManualScheduleFilterFrom}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="1"
                                Style="{StaticResource FilterDatePickerStyle}"
                                SelectedDate="{Binding DateFromDraft, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{x:Static strings:AttendanceUiStrings.ManualScheduleFilterTo}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="3"
                                Style="{StaticResource FilterDatePickerStyle}"
                                SelectedDate="{Binding DateToDraft, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="4"
                               Text="{x:Static strings:AttendanceUiStrings.ManualScheduleFilterStatus}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="5"
                              Style="{StaticResource FilterComboBoxStyle}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding StatusFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Status"
                              SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}"/>
                    <Button Grid.Column="6"
                            Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                            Command="{Binding SearchCommand}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static strings:AttendanceUiStrings.ManualScheduleFilterSearch}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{Binding ErrorMessage}"
                           MinHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource DangerFgBrush}"
                           Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding PagedItems}"
                              Style="{StaticResource AdminDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource LineBrush}"
                              BorderThickness="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static strings:ShellUiStrings.ColStt}"
                                                Binding="{Binding RowNumber}"
                                                Width="{StaticResource DataGridSttColumnWidth}"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogCenterStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridSttCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{x:Static strings:AttendanceUiStrings.ManualScheduleColFrom}"
                                                Binding="{Binding FromText}" Width="160">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{x:Static strings:AttendanceUiStrings.ManualScheduleColTo}"
                                                Binding="{Binding ToText}" Width="160">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{x:Static strings:AttendanceUiStrings.ManualScheduleColDays}"
                                                Binding="{Binding DayCount}" Width="110">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{x:Static strings:AttendanceUiStrings.ManualScheduleColStatus}"
                                                Binding="{Binding StatusText}" Width="*" MinWidth="160">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="0"
                               Text="{x:Static strings:AttendanceUiStrings.ManualScheduleEmpty}"
                               Style="{StaticResource SearchEmptyHintStyle}"/>
                    <controls:TablePaginationBar Grid.Row="1"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 TotalItems="{Binding TotalItems}"
                                                 PageSize="{Binding PageSize, Mode=TwoWay}"
                                                 PageSizeOptions="{Binding PageSizeOptions}"
                                                 UnitLabel="{Binding UnitLabel}"
                                                 GoToPageCommand="{Binding GoToPageCommand}"/>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button MinWidth="90"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CloseCommand}"
                            Content="{x:Static strings:AttendanceUiStrings.ManualScheduleClose}"/>
                </StackPanel>
            </Grid>
        </Border>
        <controls:PageBusyOverlay IsLoading="{Binding IsLoading}"
                                  IsRefreshing="{Binding IsRefreshing}"/>
    </Grid>
</shell:AppDialogWindow>
