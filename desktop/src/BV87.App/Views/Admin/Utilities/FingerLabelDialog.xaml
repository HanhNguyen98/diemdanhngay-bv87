<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.Utilities.FingerLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        Title="Ghi chú ngón tay"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="24" Padding="24" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" MinWidth="360">
        <StackPanel>
            <TextBlock x:Name="TitleBlock" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="HintBlock" Foreground="{StaticResource ContentMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>
            <TextBox x:Name="LabelBox" Style="{StaticResource FilterTextBoxStyle}" MaxLength="100" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,8,0"
                        IsCancel="True" Click="CancelButton_Click"/>
                <Button Content="Lưu" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"
                        IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
