<UserControl x:Class="BV87.App.Views.Admin.Utilities.FingerprintEnrollPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BV87.App.Controls"
             xmlns:strings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="{Binding PageTitle}"/>

        <!-- D1.1s / D-UI.12 — Group 1: search filters -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16"
                IsEnabled="{Binding IsFilterEnabled}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.DeptFilterLabel}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               Margin="0,0,10,0"/>
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              Width="220"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding DeptFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="DeptCode"
                              SelectedValue="{Binding SelectedDeptFilter, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.SearchLabel}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchDraft, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilterTextBoxStyle}"
                             Width="360"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"
                             Tag="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.SearchPlaceholder}"
                             ToolTip="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.SearchPlaceholder}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.RegistrationStatusFilterLabel}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               Margin="0,0,10,0"/>
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              Width="180"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding StatusFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Filter"
                              SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                            Command="{Binding SearchCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.SearchFilter}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Static strings:UtilitiesUiStrings.ClearFilter}"
                            Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                            Command="{Binding ResetFiltersCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:RefreshSpinIcon IsSpinning="{Binding IsRefreshing}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.RefreshStaffList}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Semantic banner -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="12,10" CornerRadius="8"
                Background="{Binding BannerTone, Converter={StaticResource BannerToneBrush}, ConverterParameter=Bg}"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding BannerMessage}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBase}"
                       Foreground="{Binding BannerTone, Converter={StaticResource BannerToneBrush}, ConverterParameter=Fg}"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- D1.1s — Group 2: staff list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid IsEnabled="{Binding IsFilterEnabled}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.StaffListTitle}"
                               Foreground="{StaticResource NavyBrush}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" MinHeight="240">
                        <DataGrid ItemsSource="{Binding FilteredStaff}"
                                  SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                                  Style="{StaticResource AdminDataGridStyle}"
                                  SelectionMode="Single"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.ColStt}"
                                                    Binding="{Binding RowNumber}"
                                                    Width="{StaticResource DataGridSttColumnWidth}"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogCenterStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridSttCellStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.ColEmpCode}"
                                                    Binding="{Binding EmpCodeFormatted}"
                                                    Width="96"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.ColFullname}"
                                                    Binding="{Binding Fullname}"
                                                    Width="220"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.ColRegistrationStatus}"
                                                          Width="*"
                                                          MinWidth="220">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogStyle}"/>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2" CornerRadius="10" HorizontalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource NeutralBgBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Registered}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RegistrationDisplay}"
                                                           ToolTip="{Binding RegistrationDisplay}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource NeutralFgBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Registered}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessFgBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource SearchEmptyHintStyle}"/>
                    </Grid>

                    <controls:TablePaginationBar Grid.Row="2"
                                                 Margin="0,12,0,0"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 TotalItems="{Binding TotalItems}"
                                                 PageSize="{Binding PageSize, Mode=TwoWay}"
                                                 PageSizeOptions="{Binding PageSizeOptions}"
                                                 UnitLabel="{Binding UnitLabel}"
                                                 GoToPageCommand="{Binding GoToPageCommand}"
                                                 Visibility="{Binding ShowPagination, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- D1.1s — Group 3: device + preview + enroll actions -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerFgBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessFgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DeviceStatusText}"
                                       FontSize="{StaticResource FontSizeLg}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DangerFgBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessFgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1" Padding="8,4" CornerRadius="12" Margin="12,0"
                                Background="{StaticResource PrimaryLightBrush}"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowScanProgressBadge, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ScanProgressBadgeText}" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                                    Command="{Binding ConnectDeviceCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsDeviceConnected, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.ConnectDevice}"/>
                            </Button>
                            <Button Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                                    Command="{Binding DisconnectDeviceCommand}"
                                    Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.DisconnectDevice}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource SurfacePageBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" MinHeight="280" Margin="0,0,0,12">
                        <Grid>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"/>
                            <TextBlock Text="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.PreviewWaiting}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeXl}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ContentMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.StartEnroll}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" Margin="0,0,8,0"
                                Click="StartEnrollButton_Click"
                                IsEnabled="{Binding CanStartEnroll}"
                                ToolTip="{Binding StartEnrollTooltip}"/>
                        <Button Content="{x:Static strings:UtilitiesUiStrings+FingerprintEnroll.CancelEnroll}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                Command="{Binding CancelEnrollCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <controls:PageBusyOverlay Grid.Row="0" Grid.RowSpan="20"
                                  IsLoading="{Binding IsLoading}"
                                  IsRefreshing="{Binding IsRefreshing}"/>
    </Grid>
</UserControl>
