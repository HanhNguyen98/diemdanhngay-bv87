<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.ClearAttendanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        xmlns:strings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="Đưa về chưa chấm"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="20" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <controls:DialogContextHeader x:Name="ContextHeader"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{StaticResource ContentHeadingBrush}"/>

            <Border x:Name="ReportWarningPanel" Padding="12" Margin="0,0,0,12"
                    Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                <TextBlock x:Name="ReportWarningText" TextWrapping="Wrap" Foreground="{StaticResource NavyBrush}"/>
            </Border>

            <TextBlock x:Name="ReasonLabelText" Foreground="{StaticResource ContentMutedBrush}" FontSize="{StaticResource FontSizeSm}"/>
            <TextBox x:Name="ReasonBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxLength="255" Margin="0,4,0,12"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,12" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="{x:Static strings:AdminUiStrings.ClearAttendanceSubmit}" Width="100"
                        Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
