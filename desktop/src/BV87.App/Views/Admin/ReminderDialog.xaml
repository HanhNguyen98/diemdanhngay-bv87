<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        Title="Gửi nhắc nhở Chấm công"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="16">
        <StackPanel>
            <TextBlock Text="Chọn đơn vị chưa hoàn thành chấm công:" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,12"/>
            <ListBox x:Name="DeptList" MaxHeight="320" BorderBrush="{StaticResource LineBrush}" Margin="0,0,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding HasHead}" Margin="4,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Gửi" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Click="Send_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
