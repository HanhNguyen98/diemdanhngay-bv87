<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.ScanLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        Title="Chi tiết quét"
        Width="860"
        Height="520"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="20" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}"/>
            <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,4,0,12"
                       Foreground="{StaticResource ContentMutedBrush}"/>

            <TextBlock x:Name="LoadingText" Grid.Row="2" Text="Đang tải..."
                       Foreground="{StaticResource ContentMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerFgBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Chưa có lần quét trong ngày này."
                       Foreground="{StaticResource ContentMutedBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" Visibility="Collapsed"/>

                <DataGrid x:Name="ItemsGrid" Grid.Row="2" Style="{StaticResource AdminDataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời điểm" Binding="{Binding TimeText}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Hướng" Binding="{Binding DirectionText}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Độ khớp vân tay" Binding="{Binding ScoreText}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Máy" Binding="{Binding MachineText}" Width="*" MinWidth="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding MessageText}" Width="*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel x:Name="PaginationPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PreviousButton" Content="Trước" Margin="0,0,8,0" Padding="12,6" Click="PreviousButton_Click"/>
                    <Button x:Name="NextButton" Content="Sau" Padding="12,6" Click="NextButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="PageSummaryText" VerticalAlignment="Center" Foreground="{StaticResource ContentMutedBrush}"/>
            </DockPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Đóng" Width="90" Style="{StaticResource PrimaryButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</shell:AppDialogWindow>
