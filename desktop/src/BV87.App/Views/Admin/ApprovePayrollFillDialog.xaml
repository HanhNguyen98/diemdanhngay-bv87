<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.ApprovePayrollFillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        xmlns:strings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="Duyệt bổ sung giờ"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="20" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <controls:DialogContextHeader x:Name="ContextHeader"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{StaticResource ContentHeadingBrush}"/>

            <Border Padding="12" Margin="0,0,0,12" Background="{StaticResource InfoBgBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Loại nghỉ trực" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="IntentValueText" Margin="0,0,0,8"/>
                    <TextBlock Text="Lý do Trưởng đơn vị" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ReasonValueText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="{x:Static strings:AdminUiStrings.PayrollFillApproveSubmit}" Width="150"
                        Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
