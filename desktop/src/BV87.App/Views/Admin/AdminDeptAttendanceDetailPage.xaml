<UserControl x:Class="BV87.App.Views.Admin.AdminDeptAttendanceDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BV87.App.Controls"
             xmlns:strings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="{x:Static strings:AdminUiStrings.DeptDetailTitle}"
                             Subtitle="{Binding PageSubtitle}"
                             ToolTip="{x:Static strings:AdminUiStrings.DailyProgressTooltip}"/>

        <Border Grid.Row="1" Style="{StaticResource LockBannerStyle}" Margin="0,0,0,16"
                Visibility="{Binding ShowLockBanner, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding LockBannerText}" Foreground="{StaticResource DangerFgBrush}" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerFgBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>

        <!-- Unified filter card (§2.11.2 / §2.11.4 / §2.11.5) -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static strings:AdminUiStrings.DeptDetailSelectDept}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource FilterComboBoxStyle}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding DeptFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="DeptCode"
                              SelectedValue="{Binding SelectedDeptFilterDraft, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="2"
                               Text="{x:Static strings:AdminUiStrings.DeptDetailSelectDate}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="3"
                                Style="{StaticResource FilterDatePickerStyle}"
                                SelectedDate="{Binding DraftDatePicker, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>
                    <TextBox Grid.Column="4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilterTextBoxStyle}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"
                             Tag="{x:Static strings:AdminUiStrings.DeptDetailSearchPlaceholder}"
                             ToolTip="{x:Static strings:AdminUiStrings.DeptDetailSearchPlaceholder}"/>
                    <TextBlock Grid.Column="5"
                               Text="{x:Static strings:AdminUiStrings.DeptDetailStatusFilter}"
                               Style="{StaticResource FilterToolbarLabelStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="6"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              Style="{StaticResource FilterComboBoxStyle}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="{x:Static strings:AdminUiStrings.UncheckedFilterTooltip}"/>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                                Command="{Binding ApplyFilterCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static strings:AdminUiStrings.DeptDetailApplyFilter}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="{x:Static strings:AdminUiStrings.ClearFilter}"
                                Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                                Command="{Binding ResetFilterCommand}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <controls:RefreshSpinIcon IsSpinning="{Binding IsRefreshing}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static strings:AdminUiStrings.RefreshDashboard}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="{x:Static strings:AdminUiStrings.DeptDetailApproveUnlock}"
                            Style="{StaticResource FilterToolbarNavyButtonStyle}"
                            Command="{Binding ApproveUnlockRequestCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding ShowApproveUnlockButton, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{x:Static strings:AdminUiStrings.DeptDetailRejectUnlock}"
                            Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                            Foreground="{StaticResource DangerFgBrush}"
                            Command="{Binding RejectUnlockRequestCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding ShowApproveUnlockButton, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{x:Static strings:AdminUiStrings.DeptDetailUnlock}"
                            Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                            Command="{Binding UnlockCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding ShowUnlockButton, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{x:Static strings:AdminUiStrings.DeptDetailRelock}"
                            Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                            Command="{Binding RelockCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding ShowRelockButton, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{x:Static strings:AdminUiStrings.DeptDetailExportReport}"
                            Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                            Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table card with internal scroll + pagination -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Static strings:AdminUiStrings.DeptDetailStaffListTitle}"
                           Style="{StaticResource SectionTitleStyle}" Margin="20,16,20,12"/>

                <TextBlock Grid.Row="1"
                           Text="{x:Static strings:AdminUiStrings.DeptDetailLoading}"
                           Foreground="{StaticResource ContentMutedBrush}" Margin="20,0,20,16"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding PagedStaff}"
                          SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                          Style="{StaticResource AdminDataGridStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          MinWidth="860"
                          Margin="0,0,0,0"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static strings:ShellUiStrings.ColStt}"
                                            Binding="{Binding RowNumber}"
                                            Width="{StaticResource DataGridSttColumnWidth}"
                                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogCenterStyle}"/>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridSttCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="MÃ NV" Binding="{Binding EmpCodeFormatted}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding Fullname}" Width="*" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="DeptColumn"
                                            Header="{x:Static strings:AdminUiStrings.DeptDetailColDept}"
                                            Binding="{Binding DeptDisplay}"
                                            Width="*" MinWidth="160"
                                            Visibility="Collapsed">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CHỨC VỤ" Binding="{Binding PositionName}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="GIỜ" Binding="{Binding DisplayTimes}" Width="160" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="MÁY" Binding="{Binding DisplayMachine}" Width="*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayStatus}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayStatus}"/>
                                        <TextBlock Text="{Binding DisplayNghiTrucSubtitle}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ContentMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayNghiTrucSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DisplayNghiTrucSubtitle}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DisplayNghiTrucSubtitle}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="LÝ DO CHẤM BỔ SUNG" Binding="{Binding Note}" Width="*" MinWidth="240">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{x:Static strings:AdminUiStrings.DeptDetailActionsMenu}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Tag="{Binding}"
                                            Click="ActionsMenuButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Style="{StaticResource SearchEmptyHintStyle}"/>

                <controls:TablePaginationBar Grid.Row="3"
                                             CurrentPage="{Binding CurrentPage}"
                                             TotalPages="{Binding TotalPages}"
                                             TotalItems="{Binding TotalItems}"
                                             PageSize="{Binding PageSize, Mode=TwoWay}"
                                             PageSizeOptions="{Binding PageSizeOptions}"
                                             UnitLabel="nhân viên"
                                             GoToPageCommand="{Binding GoToPageCommand}"
/>

                <Border Grid.Row="4" Margin="16,0,16,16" Padding="12"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding ShowQuickPanel, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"
                                   Foreground="{StaticResource ContentHeadingBrush}">
                            <Run Text="{x:Static strings:AdminUiStrings.DeptDetailQuickActions}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding SelectedStaffName, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding QuickActions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ShortLabel}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.QuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,8"
                                                ToolTip="{Binding Label}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <controls:PageBusyOverlay Grid.Row="0" Grid.RowSpan="20"
                                  IsLoading="{Binding IsLoading}"
                                  IsRefreshing="{Binding IsRefreshing}"/>
    </Grid>
</UserControl>
