<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.Catalog.AttendanceStatusCatalogFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        Width="580"
        MinWidth="580"
        Height="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="1" x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock x:Name="CodeLabel" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="CodeBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"
                             TextChanged="CodeBox_TextChanged"/>

                    <TextBlock x:Name="LabelFieldLabel" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="LabelBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"
                             TextChanged="LabelBox_TextChanged"/>

                    <TextBlock x:Name="BadgeLabelFieldLabel" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="BadgeLabelBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ColorLabel" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="ColorCombo" Style="{StaticResource FilterComboBoxStyle}"
                                      DisplayMemberPath="Label"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="IconLabel" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="IconCombo" Style="{StaticResource FilterComboBoxStyle}"
                                      DisplayMemberPath="Label"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="SortOrderLabel" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="SortOrderBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ManualAllowedLabel" Style="{StaticResource FormLabelStyle}"/>
                            <CheckBox x:Name="ManualAllowedBox" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="GroupParentLabel" Style="{StaticResource FormLabelStyle}"/>
                            <CheckBox x:Name="GroupParentBox" Margin="0,4,0,0"
                                      Checked="GroupParentBox_Changed" Unchecked="GroupParentBox_Changed"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ParentPanel" Margin="0,0,0,12">
                        <TextBlock x:Name="ParentCodeLabel" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="ParentCombo" Style="{StaticResource FilterComboBoxStyle}"
                                  DisplayMemberPath="DisplayText"/>
                    </StackPanel>

                    <TextBlock x:Name="ActiveLabel" Style="{StaticResource FormLabelStyle}"/>
                    <CheckBox x:Name="ActiveBox" Margin="0,4,0,0"
                              Checked="ActiveBox_Changed" Unchecked="ActiveBox_Changed"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="0,16,0,0" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</shell:AppDialogWindow>
