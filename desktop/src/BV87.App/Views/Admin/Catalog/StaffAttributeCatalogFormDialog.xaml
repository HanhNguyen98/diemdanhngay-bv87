<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.Catalog.StaffAttributeCatalogFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="400">
        <StackPanel>
            <controls:DialogContextHeader x:Name="ContextHeader"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <TextBlock Text="{Binding FormCodeLabel}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="CodeBox" IsReadOnly="True" Style="{StaticResource FilterTextBoxStyle}"
                     Background="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding FormNameLabel}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding FormSortLabel}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="SortOrderBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"/>

            <CheckBox x:Name="ActiveBox" Content="{Binding ActiveLabel}" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Lưu" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
