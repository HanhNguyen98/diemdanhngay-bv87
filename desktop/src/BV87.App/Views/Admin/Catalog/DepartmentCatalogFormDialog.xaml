<shell:AppDialogWindow x:Class="BV87.App.Views.Admin.Catalog.DepartmentCatalogFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        xmlns:catalog="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        SizeToContent="WidthAndHeight"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="420">
        <StackPanel>
            <controls:DialogContextHeader x:Name="ContextHeader"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <TextBlock Text="{x:Static catalog:CatalogUiStrings+Departments.FormDeptCode}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="CodeBox" IsReadOnly="True" Style="{StaticResource FilterTextBoxStyle}"
                     Background="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static catalog:CatalogUiStrings+Departments.FormGroup}" Style="{StaticResource FormLabelStyle}"/>
            <ComboBox x:Name="GroupCombo" Style="{StaticResource FilterComboBoxStyle}"
                      DisplayMemberPath="GroupName" SelectedValuePath="GroupCode" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static catalog:CatalogUiStrings+Departments.FormUnitCode}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="UnitCodeBox" Style="{StaticResource FilterTextBoxStyle}" MaxLength="20" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static catalog:CatalogUiStrings+Departments.FormDeptName}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="DeptNameBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"/>

            <StackPanel x:Name="HeadPanel" Margin="0,0,0,16">
                <TextBlock Text="Trưởng đơn vị" Style="{StaticResource FormLabelStyle}"/>
                <ComboBox x:Name="HeadCombo" Style="{StaticResource FilterComboBoxStyle}"
                          DisplayMemberPath="DisplayLabel" SelectedValuePath="EmpCode" Margin="0,0,0,4"/>
                <TextBlock x:Name="HeadHintText" TextWrapping="Wrap" Foreground="{StaticResource ContentMutedBrush}"
                           FontSize="12" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Lưu" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
