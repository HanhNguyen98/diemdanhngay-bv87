<UserControl x:Class="BV87.App.Views.Head.HeadAttendancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BV87.App.Controls"
             xmlns:head="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding PageTitle}"
                       Style="{StaticResource PageTitleStyle}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="{Binding PageSubtitle}"
                           Style="{StaticResource PageSubtitleStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           ToolTip="{x:Static head:HeadUiStrings+Attendance.DailyKpiChipTooltip}"/>
                <ItemsControl ItemsSource="{Binding RecentDates}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding}" Margin="0,0,8,0"
                                    Click="DatePill_Click"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterToolbarSecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryLightBorderBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DatePicker Style="{StaticResource FilterDatePickerStyle}"
                            Width="140"
                            SelectedDate="{Binding SelectedDatePicker, Mode=TwoWay}"
                            DisplayDateEnd="{Binding MaxSelectableDate, Mode=OneWay}"
                            ToolTip="{x:Static head:HeadUiStrings+Attendance.SelectOtherDateTooltip}"
                            VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerFgBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding KpiItems}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PrimaryLightBrush}"
                            BorderBrush="{StaticResource PrimaryLightBorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,8,8"
                            ToolTip="{x:Static head:HeadUiStrings+Attendance.DailyKpiChipTooltip}">
                        <TextBlock Foreground="{StaticResource PrimaryBrush}">
                            <Run Text="{Binding BadgeLabel, Mode=OneWay}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding Count, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Static head:HeadUiStrings+Attendance.SearchLabel}"
                           Style="{StaticResource FilterToolbarLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilterTextBoxStyle}"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         Tag="{x:Static head:HeadUiStrings+Attendance.SearchPlaceholder}"
                         ToolTip="{x:Static head:HeadUiStrings+Attendance.SearchPlaceholder}"/>
                <TextBlock Grid.Column="2"
                           Text="{x:Static head:HeadUiStrings+Attendance.StatusFilterLabel}"
                           Style="{StaticResource FilterToolbarLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding StatusFilter}"
                          Style="{StaticResource FilterComboBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          ToolTip="{x:Static head:HeadUiStrings+Attendance.UncheckedFilterTooltip}"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                            Command="{Binding ApplyFiltersCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static head:HeadUiStrings+Attendance.ApplyFilter}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <controls:RefreshSpinIcon IsSpinning="{Binding IsRefreshing}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static head:HeadUiStrings+Attendance.Refresh}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Static head:HeadUiStrings+Attendance.UnlockRequestAction}"
                            Command="{Binding SendUnlockRequestCommand}"
                            Style="{StaticResource FilterToolbarNavyButtonStyle}"
                            ToolTip="{Binding UnlockRequestButtonTooltip}"
                            Visibility="{Binding ShowUnlockRequestButton, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Static head:HeadUiStrings+Attendance.StaffListTitle}"
                           Style="{StaticResource SectionTitleStyle}" Margin="20,16,20,12"/>

                <TextBlock Grid.Row="1"
                           Text="{x:Static head:HeadUiStrings+Attendance.Loading}"
                           Foreground="{StaticResource ContentMutedBrush}" Margin="20,0,20,16"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding PagedStaff}"
                          SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                          Style="{StaticResource AdminDataGridStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          MinWidth="960"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static head:ShellUiStrings.ColStt}"
                                            Binding="{Binding RowNumber}"
                                            Width="{StaticResource DataGridSttColumnWidth}"
                                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogCenterStyle}"/>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridSttCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Attendance.ColEmpCode}"
                                            Binding="{Binding EmpCodeFormatted}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Attendance.ColFullname}"
                                            Binding="{Binding Fullname}" Width="*" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Attendance.ColRank}"
                                            Binding="{Binding RankName}" Width="*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Attendance.ColPosition}"
                                            Binding="{Binding PositionName}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Attendance.ColTimes}"
                                            Binding="{Binding DisplayTimes}" Width="*" MinWidth="280">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Attendance.ColMachine}"
                                            Binding="{Binding DisplayMachine}" Width="*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{x:Static head:HeadUiStrings+Attendance.ColStatus}"
                                            Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayStatus}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayStatus}"/>
                                        <TextBlock Text="{Binding DisplayNghiTrucSubtitle}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ContentMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayNghiTrucSubtitle}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DisplayNghiTrucSubtitle}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DisplayNghiTrucSubtitle}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Attendance.ColNote}"
                                            Binding="{Binding Note}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Style="{StaticResource SearchEmptyHintStyle}"/>

                <controls:TablePaginationBar Grid.Row="3"
                                             CurrentPage="{Binding CurrentPage}"
                                             TotalPages="{Binding TotalPages}"
                                             TotalItems="{Binding TotalItems}"
                                             PageSize="{Binding PageSize, Mode=TwoWay}"
                                             PageSizeOptions="{Binding PageSizeOptions}"
                                             UnitLabel="nhân viên"
                                             GoToPageCommand="{Binding GoToPageCommand}"
/>

                <Border Grid.Row="4" Margin="16,0,16,16" Padding="12"
                        Style="{StaticResource CardBorderFlatStyle}"
                        Visibility="{Binding ShowQuickPanel, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"
                                   Foreground="{StaticResource ContentHeadingBrush}">
                            <Run Text="{x:Static head:HeadUiStrings+Attendance.QuickActions}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding SelectedStaffName, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding QuickActions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ShortLabel}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.QuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,8"
                                                ToolTip="{Binding Label}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <controls:PageBusyOverlay Grid.Row="0" Grid.RowSpan="20"
                                  IsLoading="{Binding IsLoading}"
                                  IsRefreshing="{Binding IsRefreshing}"/>
    </Grid>
</UserControl>
