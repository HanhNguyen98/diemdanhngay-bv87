<shell:AppDialogWindow x:Class="BV87.App.Views.Head.ManualRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        Title="Gán trạng thái thủ công"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="20" Padding="20" Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="420">
        <StackPanel>
            <controls:DialogContextHeader x:Name="ContextHeader"/>

            <TextBlock Text="Từ ngày" Margin="0,0,0,4"/>
            <DatePicker x:Name="FromDatePicker" Margin="0,0,0,12"/>

            <TextBlock Text="Đến ngày" Margin="0,0,0,4"/>
            <DatePicker x:Name="ToDatePicker" Margin="0,0,0,12"/>

            <TextBlock x:Name="NoteLabel" Text="{x:Static attendance:AttendanceUiStrings.ManualRangeNoteRequired}"
                       xmlns:attendance="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="NoteBox" Height="72" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="88" Margin="0,0,8,0" Padding="8,6" Click="CancelButton_Click"/>
                <Button Content="Xác nhận" Width="100" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
