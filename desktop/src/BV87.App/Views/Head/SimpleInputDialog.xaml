<shell:AppDialogWindow x:Class="BV87.App.Views.Head.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="20" Padding="20" Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="360">
        <StackPanel>
            <controls:DialogContextHeader x:Name="ContextHeader"/>
            <TextBlock x:Name="PromptText" Foreground="{StaticResource ContentMutedBrush}" Margin="0,0,0,8"/>
            <TextBox x:Name="InputBox" MinWidth="300" Height="32" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="Lưu" Width="80" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
