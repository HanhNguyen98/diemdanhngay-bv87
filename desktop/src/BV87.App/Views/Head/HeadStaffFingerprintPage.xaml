<UserControl x:Class="BV87.App.Views.Head.HeadStaffFingerprintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BV87.App.Controls"
             xmlns:head="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="{Binding PageTitle}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerFgBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static head:HeadUiStrings+Staff.StatsTotal}"
                               Foreground="{StaticResource ContentMutedBrush}" FontSize="{StaticResource FontSizeMd}"/>
                    <TextBlock Text="{Binding StatsTotalText}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static head:HeadUiStrings+Staff.StatsRegistered}"
                               Foreground="{StaticResource ContentMutedBrush}" FontSize="{StaticResource FontSizeMd}"/>
                    <TextBlock Text="{Binding StatsRegisteredText}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                               Foreground="{StaticResource SuccessFgBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{x:Static head:HeadUiStrings+Staff.StatsMissing}"
                               Foreground="{StaticResource ContentMutedBrush}" FontSize="{StaticResource FontSizeMd}"/>
                    <TextBlock Text="{Binding StatsMissingText}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                               Foreground="{StaticResource NeutralFgBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Static head:HeadUiStrings+Staff.SearchLabel}"
                           Style="{StaticResource FilterToolbarLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchDraft, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilterTextBoxStyle}"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         Tag="{x:Static head:HeadUiStrings+Staff.SearchPlaceholder}"
                         ToolTip="{x:Static head:HeadUiStrings+Staff.SearchPlaceholder}"/>
                <TextBlock Grid.Column="2"
                           Text="{x:Static head:HeadUiStrings+Staff.FingerprintFilterLabel}"
                           Style="{StaticResource FilterToolbarLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding FingerprintFilterOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Filter"
                          SelectedValue="{Binding SelectedFingerprintFilter, Mode=TwoWay}"
                          Style="{StaticResource FilterComboBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                            Command="{Binding ApplyFilterCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static head:HeadUiStrings+Staff.ApplyFilter}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Static head:HeadUiStrings+Staff.ClearFilter}"
                            Style="{StaticResource FilterToolbarSecondaryButtonStyle}"
                            Command="{Binding ResetFiltersCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource FilterToolbarPrimaryButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:RefreshSpinIcon IsSpinning="{Binding IsRefreshing}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static head:HeadUiStrings+Staff.Refresh}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding ListTitle}"
                           Style="{StaticResource SectionTitleStyle}" Margin="20,16,20,12"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding LoadingMessage}"
                           Foreground="{StaticResource ContentMutedBrush}" Margin="20,0,20,16"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding PagedItems}"
                          Style="{StaticResource AdminDataGridStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          MinWidth="760"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static head:ShellUiStrings.ColStt}"
                                            Binding="{Binding RowNumber}"
                                            Width="{StaticResource DataGridSttColumnWidth}"
                                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogCenterStyle}"/>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridSttCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{x:Static head:HeadUiStrings+Staff.ColAvatar}"
                                                Width="140" IsReadOnly="True">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridColumnHeaderCatalogCenterStyle}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StaffAvatarThumb HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               AvatarUrl="{Binding AvatarUrl}"
                                                               Initials="{Binding Initials}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Staff.ColEmpCode}"
                                            Binding="{Binding EmpCodeFormatted}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static head:HeadUiStrings+Staff.ColFullname}"
                                            Binding="{Binding Fullname}" Width="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminDataGridTextCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{x:Static head:HeadUiStrings+Staff.ColFingerprint}"
                                                Width="*" MinWidth="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,5" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource NeutralBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding FingerLabel}"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FingerLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessFgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Registered}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource NeutralFgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static head:HeadUiStrings+Staff.ColActions}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{x:Static head:HeadUiStrings+Staff.ActionsMenuLabel}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Tag="{Binding}"
                                            Click="ActionsMenuButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Style="{StaticResource SearchEmptyHintStyle}"/>

                <controls:TablePaginationBar Grid.Row="3"
                                             CurrentPage="{Binding CurrentPage}"
                                             TotalPages="{Binding TotalPages}"
                                             TotalItems="{Binding TotalItems}"
                                             PageSize="{Binding PageSize, Mode=TwoWay}"
                                             PageSizeOptions="{Binding PageSizeOptions}"
                                             UnitLabel="{x:Static head:HeadUiStrings+Staff.UnitLabel}"
                                             GoToPageCommand="{Binding GoToPageCommand}"
/>
            </Grid>
        </Border>
        <controls:PageBusyOverlay Grid.Row="0" Grid.RowSpan="20"
                                  IsLoading="{Binding IsLoading}"
                                  IsRefreshing="{Binding IsRefreshing}"/>
    </Grid>
</UserControl>
