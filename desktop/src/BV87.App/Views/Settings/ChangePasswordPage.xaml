<UserControl x:Class="BV87.App.Views.Settings.ChangePasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BV87.App.Controls"
             xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="{Binding PageTitle}"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True">
            <Grid Margin="0,16,0,0" MinWidth="680">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{Binding AdminGapWidth}"/>
                    <ColumnDefinition Width="{Binding AdminColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderFlatStyle}"
                        Padding="32,28"
                        VerticalAlignment="Top"
                        Width="{Binding SelfCardWidth}"
                        MinWidth="{Binding SelfCardMinWidth}"
                        MaxWidth="{Binding SelfCardMaxWidth}"
                        HorizontalAlignment="{Binding SelfCardHorizontalAlignment}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerFgBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>

                        <TextBlock Text="{Binding NewPasswordLabel}" Style="{StaticResource FormLabelStyle}"/>
                        <controls:PasswordField x:Name="NewPasswordField" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding ConfirmPasswordLabel}" Style="{StaticResource FormLabelStyle}"/>
                        <controls:PasswordField x:Name="ConfirmPasswordField" Margin="0,0,0,20"/>

                        <Button x:Name="SubmitButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding SubmitLabel}"
                                Padding="16,12"
                                HorizontalAlignment="Stretch"
                                Click="SubmitButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderFlatStyle}"
                        Padding="24"
                        VerticalAlignment="Top"
                        Visibility="{Binding ShowAdminReset, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static settings:SettingsUiStrings+ChangePassword.AdminResetSectionTitle}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="{x:Static settings:SettingsUiStrings+ChangePassword.AdminResetSectionHint}"
                                   Style="{StaticResource FormHintStyle}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="{x:Static settings:SettingsUiStrings+ChangePassword.AdminResetDeptLabel}"
                                   Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                                  ItemsSource="{Binding DeptFilterOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="DeptCode"
                                  SelectedValue="{Binding DeptFilter, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="{x:Static settings:SettingsUiStrings+ChangePassword.AdminResetSearchLabel}"
                                   Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Style="{StaticResource FilterTextBoxStyle}"
                                 Margin="0,0,0,12"
                                 Tag="{x:Static settings:SettingsUiStrings+Accounts.SearchPlaceholder}"
                                 ToolTip="{x:Static settings:SettingsUiStrings+Accounts.SearchPlaceholder}"
                                 Text="{Binding AccountSearchDraft, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{Binding AdminErrorMessage}" Foreground="{StaticResource DangerFgBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding AdminErrorMessage, Converter={StaticResource NullToVisibility}}"/>

                        <TextBlock Text="{x:Static settings:SettingsUiStrings+ChangePassword.AdminResetUserLabel}"
                                   Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                                  ItemsSource="{Binding AccountOptions}"
                                  DisplayMemberPath="StaffPickerLabel"
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormPassword}"
                                   Style="{StaticResource FormLabelStyle}"/>
                        <controls:PasswordField x:Name="AdminNewPasswordField" Margin="0,0,0,12"/>

                        <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.ResetPasswordConfirm}"
                                   Style="{StaticResource FormLabelStyle}"/>
                        <controls:PasswordField x:Name="AdminConfirmPasswordField" Margin="0,0,0,16"/>

                        <Button x:Name="AdminResetButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding AdminResetSubmitLabel}"
                                Padding="16,10"
                                HorizontalAlignment="Stretch"
                                Click="AdminResetButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
