<shell:AppDialogWindow x:Class="BV87.App.Views.Settings.AccountScreensDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="{x:Static settings:SettingsUiStrings+Accounts.GrantScreensTitle}"
        SizeToContent="Height"
        Width="560"
        MinHeight="420"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <controls:DialogContextHeader x:Name="ContextHeader"/>
                <TextBlock x:Name="GroupHintText"
                           Text="{x:Static settings:SettingsUiStrings+Accounts.GrantScreensClearsGroup}"
                           TextWrapping="Wrap" Foreground="{StaticResource ContentMutedBrush}" FontSize="12"
                           Margin="0,8,0,8" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8" Background="{StaticResource SurfacePageBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScreensList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayLabel}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsAllowed}"
                                          Margin="0,4"
                                          ToolTip="{Binding Group}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{x:Static settings:SettingsUiStrings.Cancel}"
                        Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton"
                        Content="{x:Static settings:SettingsUiStrings+Accounts.GrantScreensSave}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</shell:AppDialogWindow>
