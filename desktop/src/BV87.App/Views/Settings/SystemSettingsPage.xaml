<UserControl x:Class="BV87.App.Views.Settings.SystemSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BV87.App.Controls"
             xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="{Binding PageTitle}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerFgBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Text="{x:Static settings:SettingsUiStrings.Loading}" Foreground="{StaticResource ContentMutedBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,16">
                <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{x:Static settings:SettingsUiStrings+System.SectionSystemName}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.PortalTitle}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PortalTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.PortalSubtitle}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PortalSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         MaxLength="200"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{x:Static settings:SettingsUiStrings+System.SectionBranding}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.Logo}" Style="{StaticResource FormLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{x:Static settings:SettingsUiStrings+System.LogoPick}"
                                            Command="{Binding PickLogoCommand}"
                                            Style="{StaticResource FormCompactButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="{x:Static settings:SettingsUiStrings+System.LogoRemove}"
                                            Command="{Binding RemoveLogoCommand}"
                                            Style="{StaticResource FormCompactButtonStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LogoError}" Foreground="{StaticResource DangerFgBrush}"
                                           FontSize="{StaticResource FontSizeSm}" Margin="0,0,0,8"
                                           Visibility="{Binding LogoError, Converter={StaticResource NullToVisibility}}"/>
                                <Image Source="{Binding LogoUrl, Converter={StaticResource DataUrlToImageSource}}"
                                       MaxHeight="64" MaxWidth="160" Stretch="Uniform" HorizontalAlignment="Left"
                                       Visibility="{Binding LogoUrl, Converter={StaticResource NonEmptyStringToVisibility}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.LoginAvatar}" Style="{StaticResource FormLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{x:Static settings:SettingsUiStrings+System.LoginAvatarPick}"
                                            Command="{Binding PickLoginAvatarCommand}"
                                            Style="{StaticResource FormCompactButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="{x:Static settings:SettingsUiStrings+System.LoginAvatarRemove}"
                                            Command="{Binding RemoveLoginAvatarCommand}"
                                            Style="{StaticResource FormCompactButtonStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LoginAvatarError}" Foreground="{StaticResource DangerFgBrush}"
                                           FontSize="{StaticResource FontSizeSm}" Margin="0,0,0,8"
                                           Visibility="{Binding LoginAvatarError, Converter={StaticResource NullToVisibility}}"/>
                                <Image Source="{Binding LoginAvatarUrl, Converter={StaticResource DataUrlToImageSource}}"
                                       MaxHeight="64" MaxWidth="160" Stretch="Uniform" HorizontalAlignment="Left"
                                       Visibility="{Binding LoginAvatarUrl, Converter={StaticResource NonEmptyStringToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <Button Content="{x:Static settings:SettingsUiStrings+System.ResetWorkHours}"
                                    DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Style="{StaticResource FormCompactButtonStyle}"
                                    Command="{Binding ResetWorkHoursCommand}"/>
                            <TextBlock Text="{x:Static settings:SettingsUiStrings+System.SectionWorkHours}"
                                       Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{x:Static settings:SettingsUiStrings+System.WorkHoursHint}"
                                   Style="{StaticResource FormHintStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="{x:Static settings:SettingsUiStrings+System.WorkHoursMilestoneTitle}"
                                   Style="{StaticResource FormLabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.MorningInOfficial}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding MorningInOfficial}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.NoonOutOfficial}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NoonOutOfficial}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.AfternoonInOfficial}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding AfternoonInOfficial}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.AfternoonOutOfficial}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding AfternoonOutOfficial}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Static settings:SettingsUiStrings+System.WorkHoursMidpointTitle}"
                                   Style="{StaticResource FormLabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.MorningOpen}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding MorningOpen}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.Midpoint1}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Midpoint1}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.MidpointNoon}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding MidpointNoon}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.Midpoint2}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Midpoint2}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{x:Static settings:SettingsUiStrings+System.DayClose}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding DayClose}" Style="{StaticResource FilterTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SurfacePageBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{x:Static settings:SettingsUiStrings+System.WindowPreview}"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBlock Text="{Binding WindowMorningInPreview}" Style="{StaticResource FormHintStyle}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding WindowNoonOutPreview}" Style="{StaticResource FormHintStyle}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding WindowAfternoonInPreview}" Style="{StaticResource FormHintStyle}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding WindowAfternoonOutPreview}" Style="{StaticResource FormHintStyle}" Margin="0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfacePageBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                  
                                    <TextBlock Text="{x:Static settings:SettingsUiStrings+System.LateGraceMinutes}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding LateGraceMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FilterTextBoxStyle}"/>
                                    <TextBlock Text="{x:Static settings:SettingsUiStrings+System.LateGraceHint}"
                                               Style="{StaticResource FormHintStyle}" Margin="0,6,0,16"/>
                                    <TextBlock Text="{x:Static settings:SettingsUiStrings+System.EarlyGraceMinutes}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EarlyGraceMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FilterTextBoxStyle}"/>
                                    <TextBlock Text="{x:Static settings:SettingsUiStrings+System.EarlyGraceHint}"
                                               Style="{StaticResource FormHintStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{x:Static settings:SettingsUiStrings+System.SectionLock}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                        <StackPanel>
                            <TextBlock Text="{x:Static settings:SettingsUiStrings+System.LockTime}" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding AttendanceLockTime}"
                                     Style="{StaticResource FilterTextBoxStyle}"
                                     Width="176"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Static settings:SettingsUiStrings+System.LockTimeHint}"
                                       Style="{StaticResource FormHintStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,8,0,0">
            <Button Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}"/>
        </Border>
    </Grid>
</UserControl>
