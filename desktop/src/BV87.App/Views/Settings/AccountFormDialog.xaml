<shell:AppDialogWindow x:Class="BV87.App.Views.Settings.AccountFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="440">
        <StackPanel>
            <controls:DialogContextHeader x:Name="ContextHeader"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormUsername}"
                       xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                       Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormPassword}"
                       xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                       Style="{StaticResource FormLabelStyle}"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FilterPasswordBoxStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="PasswordHintText"
                       Text="{x:Static settings:SettingsUiStrings+Accounts.FormPasswordEditHint}"
                       xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                       Foreground="{StaticResource ContentMutedBrush}" FontSize="12" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormPermissionGroup}"
                       xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                       Style="{StaticResource FormLabelStyle}"/>
            <ComboBox x:Name="PermissionGroupCombo" Style="{StaticResource FilterComboBoxStyle}"
                      DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectionChanged="PermissionGroupCombo_SelectionChanged"
                      Margin="0,0,0,4"/>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormPermissionGroupHint}"
                       xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                       TextWrapping="Wrap" Foreground="{StaticResource ContentMutedBrush}" FontSize="12" Margin="0,0,0,12"/>

            <StackPanel x:Name="StaffPanel" Margin="0,0,0,12">
                <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormDept}"
                           xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                           Style="{StaticResource FormLabelStyle}"/>
                <ComboBox x:Name="DeptCombo" Style="{StaticResource FilterComboBoxStyle}"
                          DisplayMemberPath="Label" SelectedValuePath="DeptCode"
                          SelectionChanged="DeptCombo_SelectionChanged" Margin="0,0,0,12"/>

                <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormEmployee}"
                           xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                           Style="{StaticResource FormLabelStyle}"/>
                <ComboBox x:Name="StaffCombo" Style="{StaticResource FilterComboBoxStyle}"
                          DisplayMemberPath="DisplayLabel" SelectedValuePath="Staff.EmpCode"
                          SelectionChanged="StaffCombo_SelectionChanged" Margin="0,0,0,4"/>
                <TextBlock x:Name="RoleHintText"
                           Text="{x:Static settings:SettingsUiStrings+Accounts.FormEmployeeHint}"
                           xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                           TextWrapping="Wrap" Foreground="{StaticResource ContentMutedBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel x:Name="BootstrapFullnamePanel" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormFullname}"
                           xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="FullnameBox" Style="{StaticResource FilterTextBoxStyle}"/>
            </StackPanel>

            <CheckBox x:Name="ActiveCheck" Content="{x:Static settings:SettingsUiStrings+Accounts.FormActive}"
                      xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                      Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static settings:SettingsUiStrings.Cancel}"
                        xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                        Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="{x:Static settings:SettingsUiStrings.Save}"
                        xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
