<shell:AppDialogWindow x:Class="BV87.App.Views.Settings.KioskTokenLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        Title="{x:Static settings:SettingsUiStrings+KioskTokens.RenameLabelTitle}"
        SizeToContent="WidthAndHeight" MinWidth="400" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <controls:DialogContextHeader PrimaryText="{x:Static settings:SettingsUiStrings+KioskTokens.RenameLabelBadge}"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+KioskTokens.RenameLabelField}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="LabelBox" Style="{StaticResource FilterTextBoxStyle}" MaxLength="100" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static settings:SettingsUiStrings.Cancel}" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="{x:Static settings:SettingsUiStrings+KioskTokens.RenameLabelSubmit}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
