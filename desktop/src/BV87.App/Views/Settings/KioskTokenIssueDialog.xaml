<shell:AppDialogWindow x:Class="BV87.App.Views.Settings.KioskTokenIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        xmlns:controls="clr-namespace:BV87.App.Controls"
        Title="{x:Static settings:SettingsUiStrings+KioskTokens.IssueTitle}"
        SizeToContent="WidthAndHeight" MinWidth="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="400">
        <StackPanel>
            <controls:DialogContextHeader PrimaryText="{x:Static settings:SettingsUiStrings+KioskTokens.IssueBadge}"/>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+KioskTokens.IssueSubtitle}"
                       TextWrapping="Wrap" Foreground="{StaticResource ContentMutedBrush}" Margin="0,0,0,12"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+KioskTokens.DeptLabel}" Style="{StaticResource FormLabelStyle}"/>
            <ComboBox x:Name="DeptCombo" Style="{StaticResource FilterComboBoxStyle}"
                      DisplayMemberPath="DisplayLabel" Margin="0,0,0,12"/>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+KioskTokens.LabelOptional}" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="LabelBox" Style="{StaticResource FilterTextBoxStyle}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static settings:SettingsUiStrings.Cancel}" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="{x:Static settings:SettingsUiStrings+KioskTokens.ConfirmIssue}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Click="Issue_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
