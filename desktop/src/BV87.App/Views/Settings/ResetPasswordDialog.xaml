<shell:AppDialogWindow x:Class="BV87.App.Views.Settings.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="{x:Static settings:SettingsUiStrings+Accounts.ResetPasswordTitle}"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="400">
        <StackPanel>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.ResetPasswordTitle}"
                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap" Foreground="{StaticResource ContentMutedBrush}" Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerFgBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.FormPassword}" Style="{StaticResource FormLabelStyle}"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource FilterPasswordBoxStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static settings:SettingsUiStrings+Accounts.ResetPasswordConfirm}" Style="{StaticResource FormLabelStyle}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FilterPasswordBoxStyle}" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static settings:SettingsUiStrings.Cancel}" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="{x:Static settings:SettingsUiStrings+Accounts.ResetPasswordSubmit}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
