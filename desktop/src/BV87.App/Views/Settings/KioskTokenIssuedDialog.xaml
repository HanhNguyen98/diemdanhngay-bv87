<shell:AppDialogWindow x:Class="BV87.App.Views.Settings.KioskTokenIssuedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:BV87.App.Shell"
        xmlns:settings="clr-namespace:BV87.Core.Constants;assembly=BV87.Core"
        Title="{x:Static settings:SettingsUiStrings+KioskTokens.IssuedTitle}"
        SizeToContent="WidthAndHeight" MinWidth="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource SurfacePageBrush}">
    <Border Margin="16" Padding="20" Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MinWidth="460">
        <StackPanel>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+KioskTokens.IssuedTitle}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static settings:SettingsUiStrings+KioskTokens.IssuedHint}"
                       TextWrapping="Wrap" Foreground="{StaticResource ContentMutedBrush}" Margin="0,0,0,12"/>
            <TextBox x:Name="TokenBox" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                     Style="{StaticResource FilterTextBoxStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SuccessFgBrush}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static settings:SettingsUiStrings.Copy}" Padding="16,8" Margin="0,0,8,0" Click="Copy_Click"/>
                <Button Content="{x:Static settings:SettingsUiStrings.Close}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</shell:AppDialogWindow>
