<UserControl x:Class="BV87.App.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceWhiteBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <TextBlock x:Name="TitleText"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource NavyBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="DescriptionText"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource ContentMutedBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
